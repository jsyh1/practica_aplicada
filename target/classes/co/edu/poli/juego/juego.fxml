<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="15.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.controller.CalculadoraControler">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <Label text="Calculadora"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
<TextField fx:id="txtValor1"
           promptText="Ingrese un valor"
           editable="false"
           maxWidth="250.0"/>

<Label fx:id="lblError"
       text=""
       style="-fx-text-fill: red;"/>

<HBox alignment="CENTER"
      spacing="10.0">

    <Button text="+"
            onAction="#seleccionarSuma"/>

    <Button text="-"
            onAction="#seleccionarResta"/>

    <Button text="×"
            onAction="#seleccionarMultiplicacion"/>

    <Button text="÷"
            onAction="#seleccionarDivision"/>

</HBox>

<HBox alignment="CENTER"
      spacing="10.0">

    <Button text="("
            onAction="#seleccionarParentesisAbierto"
            prefWidth="50.0"
            prefHeight="40.0"/>

    <Button text=")"
            onAction="#seleccionarParentesisCerrado"
            prefWidth="50.0"
            prefHeight="40.0"/>

</HBox>


    <Button text="Calcular"
            prefWidth="150.0"
            prefHeight="40.0"/>

    <Label text="Resultado:"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label fx:id="lblResultado"
           text="---"
           style="-fx-font-size: 20px;"/>

</VBox>