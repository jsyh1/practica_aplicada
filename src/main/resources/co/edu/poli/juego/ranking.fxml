<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.poli.controller.RankingControler">

    <VBox alignment="CENTER" prefWidth="360.0" spacing="14.0" styleClass="card, card-listado" VBox.vgrow="ALWAYS">

        <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
        </padding>

        <VBox alignment="CENTER_LEFT" spacing="2.0">
            <Label styleClass="seccion-etiqueta" text="TOP" />
            <Label styleClass="titulo" text="Ranking de partidas" textOverrun="CLIP" wrapText="true" />
            <Label styleClass="listado-subtitulo" text="Partidas completas con menor tiempo" />
        </VBox>

        <ScrollPane fitToWidth="true" prefHeight="420.0" styleClass="scroll-listado" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="contenedorRanking" spacing="10.0" />
            </content>
        </ScrollPane>

        <Label fx:id="lblMensaje" maxWidth="Infinity" styleClass="mensaje-listado" text="" wrapText="true" />

        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#volverConsulta" text="VOLVER"
                styleClass="btn-listado-volver" />

    </VBox>
</StackPane>
