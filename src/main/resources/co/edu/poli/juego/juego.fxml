<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.poli.controller.CalculadoraControler">

    <VBox alignment="CENTER" prefWidth="320.0" spacing="14.0">

        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <!-- Encabezado -->
        <VBox alignment="CENTER_LEFT" spacing="2.0">
            <Label text="All Ten" />
            <Label text="Reto de hoy" />
            <Label text="Puntaje:" />
            <Label fx:id="lblResultado" text="---" />
        </VBox>

        <!-- Casillas 1-10 (número + placeholder, sin fx:id nuevo) -->
        <GridPane hgap="10.0" prefHeight="210.0" prefWidth="148.0" vgap="10.0">
            <children>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="1)" />
                    <Label prefHeight="17.0" prefWidth="110.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="2)" />
                    <Label prefHeight="17.0" prefWidth="132.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="3)" />
                    <Label prefHeight="17.0" prefWidth="110.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="4)" />
                    <Label prefHeight="17.0" prefWidth="131.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="5)" />
                    <Label prefHeight="17.0" prefWidth="109.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="6)" />
                    <Label prefHeight="17.0" prefWidth="132.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="7)" />
                    <Label prefHeight="17.0" prefWidth="108.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="8)" />
                    <Label prefHeight="17.0" prefWidth="135.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label text="9)" />
                    <Label prefHeight="17.0" prefWidth="108.0" text="Text field" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Label text="10)" />
                    <Label prefHeight="17.0" prefWidth="132.0" text="Text field" />
                </VBox>

            </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Expresión / resultado en curso -->
        <TextField fx:id="txtValor1" editable="false" maxWidth="Infinity" promptText="Ingrese un valor" />

        <Label fx:id="lblError" text="" />

        <!-- Fila 1: números -->
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button alignment="CENTER" onAction="#seleccionarNumero" text="1" textAlignment="CENTER" />
                <Button mnemonicParsing="false" onAction="#seleccionarNumero" text="2" />
                <Button mnemonicParsing="false" onAction="#seleccionarNumero" text="3" />
                <Button mnemonicParsing="false" onAction="#seleccionarNumero" text="4" />
            </children>
        </HBox>

        <!-- Fila 2: paréntesis y borrado -->
        <HBox alignment="CENTER" spacing="10.0">

            <Button onAction="#seleccionarParentesisAbierto" text="(" />

            <Button onAction="#seleccionarParentesisCerrado" text=")" />

            <Button mnemonicParsing="false" onAction="#borrarUltimo" text="⌫" />

            <Button mnemonicParsing="false" onAction="#borrarTodo" text="↶" />

        </HBox>

        <!-- Fila 3: operadores -->
        <HBox alignment="CENTER" spacing="10.0">

            <Button onAction="#seleccionarSuma" text="+" />

            <Button onAction="#seleccionarResta" text="-" />

            <Button onAction="#seleccionarMultiplicacion" text="*" />

            <Button onAction="#seleccionarDivision" text="÷" />

        </HBox>

        <!-- Comprobar -->
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#resultado" text="Comprobar" />

    </VBox>
</StackPane>
