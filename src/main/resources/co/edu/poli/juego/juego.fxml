<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.poli.controller.CalculadoraControler">

    <VBox alignment="CENTER" prefWidth="320.0" spacing="14.0" styleClass="card" StackPane.alignment="CENTER">

        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <!-- Encabezado -->
        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="204.0" spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="All Ten" styleClass="titulo" />
                    <Label text="Reto de hoy" styleClass="subtitulo" />
                <HBox alignment="CENTER_LEFT" spacing="4.0">
                    <Label fx:id="lblFecha" styleClass="progreso" />
                    <Label text="·" styleClass="progreso" />
                    <Label fx:id="lblResultado" text="0/10" styleClass="progreso" />
                    <Label text="·" styleClass="progreso" />
                    <Label fx:id="lblTiempo" text="00:00" styleClass="progreso" />
                </HBox>
                </VBox>
                <Button fx:id="btnMenu" alignment="CENTER" mnemonicParsing="false" onAction="#mostrarMenu" prefHeight="20.0" prefWidth="32.0" text="☰" styleClass="btn-menu"/>             
            </children>
        </HBox>

        <!-- Casillas 1-10 (número + placeholder, sin fx:id nuevo) -->

        <GridPane hgap="10.0" prefHeight="210.0" prefWidth="300.0" vgap="10.0">
            <children>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="140.0">
            <Label text="1)" />
            <Label fx:id="lblResultado1" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="140.0">
            <Label text="2)" />
            <Label fx:id="lblResultado2" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="0" GridPane.rowIndex="1" prefWidth="140.0">
            <Label text="3)" />
            <Label fx:id="lblResultado3" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="140.0">
            <Label text="4)" />
            <Label fx:id="lblResultado4" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="0" GridPane.rowIndex="2" prefWidth="140.0">
            <Label text="5)" />
            <Label fx:id="lblResultado5" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="140.0">
            <Label text="6)" />
            <Label fx:id="lblResultado6" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="0" GridPane.rowIndex="3" prefWidth="140.0">
            <Label text="7)" />
            <Label fx:id="lblResultado7" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="140.0">
            <Label text="8)" />
            <Label fx:id="lblResultado8" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="0" GridPane.rowIndex="4" prefWidth="140.0">
            <Label text="9)" />
            <Label fx:id="lblResultado9" text="" />
        </VBox>

        <VBox styleClass="casilla-pendiente" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="140.0">
            <Label text="10)" />
            <Label fx:id="lblResultado10" text="" />
        </VBox>

            </children>
        <columnConstraints>
            <ColumnConstraints prefWidth="140.0" />
            <ColumnConstraints prefWidth="140.0" />
        </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Expresión / resultado en curso -->
        <TextField fx:id="txtValor1" alignment="CENTER_RIGHT" editable="false" maxWidth="Infinity" styleClass="barra-resultado" />

        <Label fx:id="lblError" styleClass="lbl-error" text="" wrapText="true" />

		<!-- Fila 1: números -->

		<HBox fx:id="contenedorNumeros" alignment="CENTER" spacing="10.0" />

        <!-- Fila 2: paréntesis y borrado -->
        <HBox alignment="CENTER" spacing="10.0">
		<Button fx:id="btnParentesisAbre" onAction="#seleccionarParentesisAbierto" text="(" styleClass="btn-base, btn-operador"/>
		<Button fx:id="btnParentesisCierra" onAction="#seleccionarParentesisCerrado" text=")" styleClass="btn-base, btn-operador"/>
        <Button fx:id="btnBorrarUltimo" mnemonicParsing="false" onAction="#borrarUltimo" text="⌫" styleClass="btn-base, btn-operador"/>
        <Button fx:id="btnBorrarTodo" mnemonicParsing="false" onAction="#borrarTodo" text="↶" styleClass="btn-base, btn-operador"/>
        </HBox>

        <!-- Fila 3: operadores -->
        <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnSuma" onAction="#seleccionarSuma" text="+" styleClass="btn-base, btn-operador"/>
        <Button fx:id="btnResta" onAction="#seleccionarResta" text="-" styleClass="btn-base, btn-operador"/>
        <Button fx:id="btnMultiplicacion" onAction="#seleccionarMultiplicacion" text="*" styleClass="btn-base, btn-operador"/>
        <Button fx:id="btnDivision" onAction="#seleccionarDivision" text="÷" styleClass="btn-base, btn-operador"/>
        </HBox>

        <!-- Comprobar -->
        <Button fx:id="btnIgual" onAction="#resultado" text="Comprobar" styleClass="btn-comprobar" maxWidth="Infinity"/>
    </VBox>
</StackPane>
