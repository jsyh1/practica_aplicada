<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.RowConstraints?>

<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="387.0" prefWidth="292.0" spacing="15.0"
   xmlns="http://javafx.com/javafx/26"
   xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="co.edu.poli.controller.CalculadoraControler">

<!-- Información del juego -->
<GridPane>

    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
    </rowConstraints>

    <children>
        <Button mnemonicParsing="false"
                onAction="#btnCompartir"
                text="♧"
                GridPane.rowIndex="1"/>

        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;"
               text="Puntaje:"
               GridPane.columnIndex="1"/>

        <Label fx:id="lblPuntaje"
               style="-fx-font-size: 20px;"
               text="---"
               GridPane.columnIndex="1"
               GridPane.rowIndex="2"/>
    </children>

</GridPane>


<!-- Tablero de números -->
<GridPane hgap="5.0" vgap="5.0">

    <columnConstraints>
        <ColumnConstraints/>
        <ColumnConstraints/>
        <ColumnConstraints/>
        <ColumnConstraints/>
        <ColumnConstraints/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints/>
        <RowConstraints/>
    </rowConstraints>

    <children>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="1"
               textAlignment="CENTER"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="2"
               GridPane.columnIndex="1"
               GridPane.rowIndex="0"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="3"
               GridPane.columnIndex="2"
               GridPane.rowIndex="0"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="4"
               GridPane.columnIndex="3"
               GridPane.rowIndex="0"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="5"
               GridPane.columnIndex="4"
               GridPane.rowIndex="0"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="6"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="7"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="8"
               GridPane.columnIndex="2"
               GridPane.rowIndex="1"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="9"
               GridPane.columnIndex="3"
               GridPane.rowIndex="1"/>

        <Label alignment="CENTER"
               prefHeight="40.0"
               prefWidth="50.0"
               style="-fx-border-color: black;"
               text="10"
               GridPane.columnIndex="4"
               GridPane.rowIndex="1"/>

    </children>

</GridPane>


<!-- Expresión / resultado en curso -->
<TextField fx:id="txtValor1"
           editable="false"
           maxWidth="Infinity"
           promptText="Ingrese un valor"/>

<Label fx:id="lblError"
       text=""/>


<!-- Fila 1: números -->
<HBox alignment="CENTER" spacing="10.0">

    <children>

        <Button alignment="CENTER"
                onAction="#seleccionarNumero"
                text="1"
                textAlignment="CENTER"/>

        <Button mnemonicParsing="false"
                onAction="#seleccionarNumero"
                text="2"/>

        <Button mnemonicParsing="false"
                onAction="#seleccionarNumero"
                text="3"/>

        <Button mnemonicParsing="false"
                onAction="#seleccionarNumero"
                text="4"/>

    </children>

</HBox>


<!-- Fila 2: paréntesis y borrado -->
<HBox alignment="CENTER" spacing="10.0">

    <Button onAction="#seleccionarParentesisAbierto"
            text="("/>

    <Button onAction="#seleccionarParentesisCerrado"
            text=")"/>

    <Button mnemonicParsing="false"
            onAction="#borrarUltimo"
            text="⌫"/>

    <Button mnemonicParsing="false"
            onAction="#borrarTodo"
            text="↶"/>

</HBox>


<!-- Fila 3: operadores -->
<HBox alignment="CENTER" spacing="10.0">

    <Button onAction="#seleccionarSuma"
            text="+"/>

    <Button onAction="#seleccionarResta"
            text="-"/>

    <Button onAction="#seleccionarMultiplicacion"
            text="*"/>

    <Button onAction="#seleccionarDivision"
            text="÷"/>

</HBox>


<!-- Comprobar -->
<Button maxWidth="Infinity"
        mnemonicParsing="false"
        onAction="#resultado"
        text="Comprobar"/>


</VBox>
